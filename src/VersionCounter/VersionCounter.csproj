<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PackageVersion>1.0.37</PackageVersion>
    <Title>Version Counter by Yamamari</Title>
    <AssemblyVersion>1.0.37</AssemblyVersion>
    <FileVersion>1.0.37</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>Yamamari.Library.VersionCounter</RootNamespace>
    <PackageProjectUrl>https://github.com/yamamari-llc/library-versioncounter</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Resources/yamamari-logo-package.png</PackageIcon>
    <RepositoryUrl>https://github.com/yamamari-llc/library-versioncounter</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageId>VersionCounter</PackageId>
    <AutoIncrementPackageRevision>true</AutoIncrementPackageRevision>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Resources/yamamari-logo-package.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md">
      <Link>Resources/README.md</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>