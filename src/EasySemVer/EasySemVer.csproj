<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageVersion>20.0.0</PackageVersion>
    <AssemblyVersion>20.0.0</AssemblyVersion>
    <FileVersion>20.0.0</FileVersion>
    <Title>EasySemVer by Winterborn</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>Winterborn.Tools.EasySemVer</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- An SPDX expression rather than PackageLicenseFile: nuget.org renders it as a link to the
         canonical licence text, so the repository's LICENSE does not have to be packed to say
         the same thing twice. Keep it in step with LICENSE at the repository root. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Resources/logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/winterborn-llc/easysemver</PackageProjectUrl>
    <RepositoryUrl>https://github.com/winterborn-llc/easysemver</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageId>Winterborn.Tools.EasySemVer</PackageId>
    <!-- PKG-01: the deliverable is a command, not a library to reference. `dotnet tool install`
         puts `easysemver` on the path; nothing imports this package into a build. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>easysemver</ToolCommandName>
    <LangVersion>14</LangVersion>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>Winterborn.Tools.EasySemVer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md">
      <Link>Resources/README.md</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources/logo.png" />
    <None Include="Resources/logo.png" Pack="true" PackagePath="Resources/" />
    <EmbeddedResource Include="Resources/logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
</Project>