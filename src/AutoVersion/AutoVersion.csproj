<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <PackageVersion>1.0.51</PackageVersion>
    <AssemblyVersion>1.0.51</AssemblyVersion>
    <FileVersion>1.0.51</FileVersion>
    <Title>Auto-Version by Yamamari</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RootNamespace>Yamamari.Library.AutoVersion</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Resources/yamamari-logo-package.png</PackageIcon>
    <PackageProjectUrl>https://github.com/yamamari-llc/library-autoversion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yamamari-llc/library-autoversion</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageId>AutoVersion</PackageId>
    <EnableDynamicLoading>True</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Resources/yamamari-logo-package.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md">
      <Link>Resources/README.md</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TargetDir)AutoVersion">
      <Pack>True</Pack>
      <PackagePath>\lib\net6.0</PackagePath>
    </None>
  </ItemGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="./$(OutDir)AutoVersion ./$(ProjectFileName)" />
  </Target>
</Project>